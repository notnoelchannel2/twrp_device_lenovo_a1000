/boot          emmc     /dev/block/mmcblk0p16                        flags=backup=1;display="boot"
/recovery      emmc     /dev/block/mmcblk0p20                        flags=backup=1;display="recovery"
/data          ext4     /dev/block/mmcblk0p22                        length=-16384;flags=backup=1;display="data"
/system        ext4     /dev/block/mmcblk0p17                        flags=backup=1;display="system"
/cache  ext4     /dev/block/platform/sdio_emmc/by-name/cache    flags=display="cache"
/productinfo    ext4    /dev/block/platform/sdio_emmc/by-name/prodnv    flags=backup=1
/logo   emmc    /dev/block/platform/sdio_emmc/by-name/logo flags=backup=1;display=logo
/fbootlogo  emmc        /dev/block/platform/sdio_emmc/by-name/fbootlogo flags=backup=1;display=fbootlogo
/misc   emmc    /dev/block/platform/sdio_emmc/by-name/misc
/miscdata       emmc    /dev/block/platform/sdio_emmc/by-name/miscdata
/external_sd    vfat    /dev/block/mmcblk1p1    flags=display="SD card";storage;wipeingui;removable